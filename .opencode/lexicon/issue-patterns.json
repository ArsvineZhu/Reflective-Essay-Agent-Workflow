{
  "name": "issue-patterns",
  "version": "1.0",
  "description": "常见问题模式库 - 识别文章中的常见扣分点和改进方向",
  "issueCategories": {
    "structure_issues": {
      "name": "结构问题",
      "patterns": [
        {
          "name": "说教框架",
          "keywords": [
            "我们必须承认", "值得注意的是", "需要指出的是", "应该看到",
            "要知道", "请记住", "别忘了", "重要的是", "关键在于"
          ],
          "severity": "medium",
          "suggestion": "用事实和场景自然呈现观点，避免使用脚手架式的引导句"
        },
        {
          "name": "议论文结构",
          "keywords": [
            "首先", "其次", "再次", "最后", "综上所述", "总而言之",
            "第一", "第二", "第三", "一方面", "另一方面"
          ],
          "severity": "high",
          "suggestion": "思想随笔不需要分点论述，让思考的螺旋自然展开"
        },
        {
          "name": "转折过多",
          "keywords": [
            "但是", "然而", "可是", "不过", "虽然", "尽管", "却"
          ],
          "severity": "medium",
          "suggestion": "过多转折会打断阅读节奏，尝试用内在逻辑替代显性转折词"
        },
        {
          "name": "结尾收束太干净",
          "keywords": [
            "所以", "因此", "因而", "故而", "于是", "所以说"
          ],
          "severity": "medium",
          "suggestion": "保留结尾的开放性，让读者自己完成思考闭环"
        }
      ]
    },
    "voice_issues": {
      "name": "文风问题",
      "patterns": [
        {
          "name": "感叹号滥用",
          "keywords": ["!", "！"],
          "severity": "high",
          "suggestion": "让句子本身承载力量，避免用感叹号加强语气"
        },
        {
          "name": "居高临下的说教",
          "keywords": [
            "你应该", "你要", "你需要", "你必须", "人们应该",
            "大家要", "必须认识到", "要明白", "要知道"
          ],
          "severity": "high",
          "suggestion": "用\"我们\"替代\"你\"，并肩面对共同面对问题，而非指导读者"
        },
        {
          "name": "鸡汤励志",
          "keywords": [
            "加油", "明天会更好", "一切都会好的", "阳光总在风雨后",
            "不忘初心", "方得始终", "砥砺前行", "未来可期"
          ],
          "severity": "medium",
          "suggestion": "避免廉价励志，承认黑暗后依然选择光才是真正的力量"
        },
        {
          "name": "学术化引用",
          "keywords": [
            "据调查", "数据显示", "研究表明", "统计显示",
            "根据", "据统计", "某某说", "某某认为"
          ],
          "severity": "medium",
          "suggestion": "把外部数据消化为个人观察和具体场景，避免直接引用权威"
        }
      ]
    },
    "content_issues": {
      "name": "内容问题",
      "patterns": [
        {
          "name": "概念堆砌",
          "keywords": [
            "存在主义", "虚无主义", "犬儒", "荒诞", "异化",
            "内卷", "躺平", "PUA", "精神内耗", "内卷化"
          ],
          "severity": "medium",
          "suggestion": "学术概念需要用具体场景落地，避免直接堆砌术语"
        },
        {
          "name": "隐喻过多",
          "keywords": [
            "像", "如", "似", "仿佛", "犹如", "宛如", "如同"
          ],
          "severity": "medium",
          "suggestion": "选择1-2个核心意象贯穿，避免隐喻堆砌"
        },
        {
          "name": "金句设计感过强",
          "keywords": [
            "真正的", "本质上", "说到底", "其实", "事实是",
            "所谓", "何谓", "何为", "什么是"
          ],
          "severity": "low",
          "suggestion": "金句应从论证中自然生长，避免为金句而金句"
        },
        {
          "name": "举例通用化",
          "keywords": [
            "有人", "有些人", "有的人", "朋友", "我有一个朋友",
            "听说", "据说", "传言"
          ],
          "severity": "medium",
          "suggestion": "用具体的个人观察和经历替代泛化的\"有人\""
        }
      ]
    },
    "language_issues": {
      "name": "语言问题",
      "patterns": [
        {
          "name": "翻译腔",
          "keywords": [
            "正如我们所知道的", "众所周知", "在这个世界上",
            "可以这么说", "从某种意义上说", "在很大程度上"
          ],
          "severity": "medium",
          "suggestion": "用更地道的中文表达，避免翻译腔"
        },
        {
          "name": "陈词滥调",
          "keywords": [
            "时光荏苒", "岁月如梭", "白驹过隙", "逝者如斯",
            "光阴似箭", "日月如梭", "沧海桑田", "物是人非"
          ],
          "severity": "medium",
          "suggestion": "用个人化的具体表述替代成语和套话"
        },
        {
          "name": "模糊表述",
          "keywords": [
            "某种", "某种程度上", "一定程度上", "多多少少",
            "比较", "相对", "比较而言"
          ],
          "severity": "low",
          "suggestion": "精确表达观点，用具体场景替代模糊表述"
        },
        {
          "name": "副词滥用",
          "keywords": [
            "非常", "极其", "十分", "相当", "很", "真的",
            "确实", "实在", "简直", "几乎"
          ],
          "severity": "low",
          "suggestion": "用名词和动词的力量替代副词修饰"
        }
      ]
    },
    "originality_issues": {
      "name": "原创性问题",
      "patterns": [
        {
          "name": "网络流行语",
          "keywords": [
            "YYDS", "绝绝子", "破防", "emo", "躺平", "内卷",
            "打工人", "干饭人", "工具人", "尾款人"
          ],
          "severity": "medium",
          "suggestion": "流行语时效性强，用更持久的表达承载深度"
        },
        {
          "name": "引用过度",
          "keywords": [
            "鲁迅说", "王小波说", "某某曾说", "正如某某所言",
            "有句话说", "俗话说", "常言道", "古语有云"
          ],
          "severity": "medium",
          "suggestion": "消化他人观点用自己的语言表达，避免直接引语"
        }
      ]
    }
  },
  "improvementDirections": {
    "concrete": {
      "name": "具体化建议",
      "patterns": [
        "添加具体的时间、地点、人物",
        "增加感官细节：视觉、听觉、嗅觉、触觉、味觉",
        "用具体场景替代抽象概括"
      ]
    },
    "specific": {
      "name": "个人化建议",
      "patterns": [
        "用\"我\"的观察替代\"人们\"的泛化",
        "加入个人经历和感受",
        "避免空泛的道德评判"
      ]
    },
    "structural": {
      "name": "结构性建议",
      "patterns": [
        "检查段落长度变化，避免过长或过短",
        "调整转折位置，让论证更自然",
        "优化金句位置，放在张力最大处"
      ]
    }
  }
}
