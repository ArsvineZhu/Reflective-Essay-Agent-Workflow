# ==============================================
# OpenCode 项目专用
# ==============================================

# 文章索引缓存
output/.article-index.json

# 临时文件
tmp/
*.tmp
*.bak

# OpenCode 本地配置（不提交，团队共用配置通过 opencode.json 管理）
.opencode/local.json
.opencode/.opencode.json

# OpenCode 缓存和临时目录
.opencode/cache/
.opencode/tmp/

# OpenCode 插件依赖
.opencode/node_modules/

# OpenCode 工具输出目录（用户主目录下的共享输出）
# 注意：这些是全局路径，通常不应该在项目 gitignore 中
# 但为了完整起见，如果你有符号链接或特殊配置

# ==============================================
# Node.js
# ==============================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ==============================================
# 项目产出
# ==============================================

# 归档
archive/

# 输出目录中的临时文件（保留文章本身）
output/*.tmp
output/*-backup.txt

# ==============================================
# IDE 和编辑器
# ==============================================
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# ==============================================
# 系统文件
# ==============================================
.DS_Store
Thumbs.db
desktop.ini

# ==============================================
# 日志和调试
# ==============================================
*.log
logs/
debug/
*.debug

# ==============================================
# 环境变量（不提交敏感信息）
# ==============================================
.env
.env.local
.env.*.local
